# Copy this file to .env and fill in values as you set up optional features.
# The app works fully without any of these — see README for setup steps.

# Cloud sync (Settings -> Cloud Sync) — see README "Cloud sync setup"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI features (Settings -> AI Features) — see README "AI features setup"
# Requires the two Supabase variables above plus the ai-proxy edge function deployed.
VITE_AI_PROXY_URL=
